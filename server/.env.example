NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5433/alongside

# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET signs session, share-link and collab tokens.
# CREDENTIALS_KEY seals the provider API keys people bring; rotating it makes
# every stored key unreadable, so treat it as permanent.
SESSION_SECRET=replace-with-32-plus-random-characters-please
CREDENTIALS_KEY=replace-with-32-plus-random-characters-please

# Comma-separated. Only needed for browsers that reach the API directly; in
# production the app proxies /api under its own origin.
CORS_ORIGIN=http://localhost:3020

# Where share links send a browser once redeemed.
API_ORIGIN=http://localhost:4000
