# The API as the browser reaches it. Relative in production, where the app
# proxies /api under its own origin so the session stays a first-party cookie.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The collaboration socket. A WebSocket upgrade cannot be proxied, so this
# always names the API directly.
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000/collab

# Where this server reaches the API, and the target of the /api rewrite.
# Read at build time, because Next resolves rewrites into the build manifest.
API_INTERNAL_URL=http://localhost:4000/api

# Host port for the local Postgres container.
POSTGRES_PORT=5433
